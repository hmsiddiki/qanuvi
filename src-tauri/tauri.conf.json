{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qanuvi",
  "version": "0.1.18",
  "identifier": "dev.qanuvi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qanuvi",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#141416",
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Qanuvi",
        "uninstallerHeaderImage": "icons/installer-header.bmp",
        "customLanguageFiles": {
          "English": "installer/English.nsh"
        }
      }
    },
    "publisher": "Inner IT",
    "copyright": "© 2026 Inner IT",
    "shortDescription": "Qanuvi",
    "longDescription": "Qanuvi: an AI assistant that codes, thinks and researches, with its own task runner.",
    "homepage": "https://qanuvi.com"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBNEU1OTk1NTgwQ0FGRDcKUldUWHJ3eFlsVmxPbXFaVENDRjREdHhIVlkxeUlMUVJBeXJrWnUwaGxBRERQYmNTQlpqU01RRXkK",
      "endpoints": ["https://qlopy.top/qanuvi-updates/dev/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
